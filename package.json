{
	"name": "app-bailleurs-back",
	"version": "2.0.0",
	"description": "Backend bailleurs — Express 5 + TypeScript",
	"main": "dist/index.js",
	"scripts": {
		"dev": "nodemon --exec ts-node -r tsconfig-paths/register src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"migrate:owner-config-table": "node scripts/run-sql-migration.js migrations/sql/20260412_rename_sciconfig_to_ownerconfig.sql",
		"prepare": "husky",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"commitlint": "commitlint --from=HEAD~1 --to=HEAD --verbose"
	},
	"author": "Bruce LIOU",
	"license": "MIT",
	"dependencies": {
		"@types/archiver": "^7.0.0",
		"@types/google-spreadsheet": "^3.3.2",
		"@types/nodemailer": "^8.0.0",
		"@types/pdfkit": "^0.17.5",
		"archiver": "^7.0.1",
		"cloudinary": "^2.9.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^17.4.1",
		"express": "^5.2.1",
		"express-formidable": "^1.2.0",
		"googleapis": "^171.4.0",
		"imap-simple": "^5.1.0",
		"jsonwebtoken": "^9.0.3",
		"mailparser": "^3.9.8",
		"node-cron": "^4.2.1",
		"nodemailer": "^8.0.5",
		"pdfkit": "^0.18.0",
		"pg": "^8.20.0",
		"pg-hstore": "^2.3.4",
		"sequelize": "^6.37.8",
		"ws": "^8.20.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/imap-simple": "^4.2.10",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/mailparser": "^3.4.6",
		"@types/node": "^22.19.17",
		"@types/node-cron": "^3.0.11",
		"@types/ws": "^8.18.1",
		"husky": "^9.1.7",
		"lint-staged": "^15.2.10",
		"nodemon": "^3.1.14",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^6.0.2"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css,scss,md}": "biome check --write --files-ignore-unknown=true"
	}
}
